# FieldClaw Supervisor Claw — COPY to ~/.hermes-fieldclaw/.env and fill keys.
# Never commit real secrets in this file.
HERMES_HOME=/home/rdksupe/.hermes-fieldclaw

# OpenRouter (chat). Free fallbacks in config.yaml.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2:floor

# Datalab — PDF/doc conversion for wiki ingest
DATALAB_API_KEY=
DATALAB_MODE=balanced

# smallest.ai (STT/TTS)
SMALLEST_API_KEY=

# Telegram
# Leave TELEGRAM_ALLOWED_USERS empty to require the pairing handshake.
# Setting an id here skips pairing for that user.
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=
TELEGRAM_ALLOWED_USERS=

# AgentMail — agent mailbox (NOT Gmail)
# Create API key + inbox at https://console.agentmail.to
AGENTMAIL_API_KEY=

# The EMAIL_* block below enables the Hermes email *chat* adapter, which treats
# inbound mail as DMs and auto-replies to it. FieldClaw does not use it: site
# mail is parsed by the mail-poll cron against the AgentMail REST API, keyed on
# each project's inbox_email. Leave these commented unless you actually want the
# agent conversing over email. deploy/hermes/harden_profile.sh re-comments them.
# EMAIL_ADDRESS=                  # e.g. fieldclaw@agentmail.to
# EMAIL_PASSWORD=                 # same as AGENTMAIL_API_KEY
# EMAIL_IMAP_HOST=imap.agentmail.to
# EMAIL_SMTP_HOST=smtp.agentmail.to
# EMAIL_SMTP_PORT=465
# EMAIL_HOME_ADDRESS=

# FieldClaw API projection
FIELDCLAW_BASE_URL=http://127.0.0.1:8000
FIELDCLAW_API_KEY=dev-key-change-me
FIELDCLAW_PROJECT_ID=
FIELDCLAW_KB_DIR=/home/rdksupe/building_shit/buildsync/kb

# Mem0 — per-Telegram-user memory (https://app.mem0.ai Hobby free tier)
# Do not set MEM0_USER_ID — Hermes uses each Telegram user id.
MEM0_API_KEY=

# Gmail for the sim emitter lives in sim/.env.sim — never here.
